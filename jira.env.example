# ARIS Jira 연결 설정
# 이 파일을 복사해 이름을 jira.env로 바꾼 뒤, '=' 뒤에 값을 채우고 저장하세요. 저장 후 python web.py를 다시 실행합니다.
# 값이 하나라도 비어 있으면 Jira에 등록하지 않고 dry-run(등록 내용만 출력)으로 동작합니다.
# ⚠ API 토큰은 비밀번호와 같습니다. 이 파일을 다른 사람에게 보내거나 GitHub에 올리지 마세요.

# Jira 사이트 주소 (예: https://dowon-qa.atlassian.net)
JIRA_URL=

# Jira 가입 이메일
JIRA_EMAIL=

# API 토큰 (https://id.atlassian.com/manage-profile/security/api-tokens 에서 발급)
JIRA_TOKEN=

# 프로젝트 키 (예: QA)
JIRA_PROJECT=

# 이슈 유형 이름. 프로젝트에 'Bug'가 없으면 실제 이름으로 바꾸세요 (예: 버그, Task, 작업)
JIRA_ISSUE_TYPE=Bug

# 이슈 본문의 '실행자'에 표시할 이름 (비워두면 PC 사용자 이름)
ARIS_TESTER=
